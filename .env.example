# Copy to .env (never commit .env). Values here are placeholders.
# Required: TAPETIDE_API_TOKEN. Everything else is optional or has the default shown.
# Blank values (KEY=) count as "not set".

# Database (SQLite now; PostgreSQL URL later)
DATABASE_URL=sqlite:///data/private/equitypulse.db

# Tapetide MCP (personal API token from Tapetide settings)
TAPETIDE_MCP_URL=https://mcp.tapetide.com/mcp
# Required:
TAPETIDE_API_TOKEN=
# Tapetide Starter: 400 calls/day, 5,000/month (checked over a rolling 30 days)
TAPETIDE_DAILY_BUDGET=400
TAPETIDE_MONTHLY_BUDGET=5000

# LLM (later phases)
OPENROUTER_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=equitypulse

# Email alerts (later phases)
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_TO=

# NSE downloads
NSE_REQUEST_DELAY_SECONDS=1.5
