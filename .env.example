# Copy to .env (never commit .env). Values here are placeholders.

# Database (SQLite now; PostgreSQL URL later)
DATABASE_URL=sqlite:///data/private/equitypulse.db

# Tapetide MCP (personal API token from Tapetide settings)
TAPETIDE_MCP_URL=https://mcp.tapetide.com/mcp
TAPETIDE_API_TOKEN=
TAPETIDE_DAILY_BUDGET=45

# LLM (later phases)
OPENROUTER_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=equitypulse

# Email alerts (later phases)
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_TO=

# NSE downloads
NSE_REQUEST_DELAY_SECONDS=1.5
